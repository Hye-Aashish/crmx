# Server Port
PORT=5000

# JSON Web Token Secret Key (REQUIRED in production — use a long random string)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Environment (development | production)
NODE_ENV=development

# Client Frontend URL (optional, for CORS / embeds)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.u1tksmw.mongodb.net/crmx?retryWrites=true&w=majority
